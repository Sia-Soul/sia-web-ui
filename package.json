{
  "name": "sia-web-ui-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "release:ui": "node scripts/publish-ui.mjs",
    "build:business": "node scripts/build-business.mjs",
    "dev": "pnpm --filter @sia-ui/docs dev",
    "build": "pnpm --filter @sia.soul/sia-react-ui build && pnpm --filter @sia-ui/docs build",
    "desktop:dev": "pnpm --filter @sia-ui/desktop tauri dev",
    "desktop:build": "pnpm --filter @sia-ui/desktop tauri build --no-bundle",
    "desktop:bundle": "pnpm --filter @sia-ui/desktop tauri build",
    "desktop:web": "pnpm --filter @sia-ui/desktop dev",
    "database:dev": "pnpm --filter @sia-ui/database-studio tauri:dev",
    "database:build": "pnpm --filter @sia-ui/database-studio tauri:build:bin",
    "database:bundle": "pnpm --filter @sia-ui/database-studio tauri:build",
    "database:web": "pnpm --filter @sia-ui/database-studio dev",
    "browser:dev": "pnpm --filter @sia-ui/browser tauri:dev",
    "browser:build": "pnpm --filter @sia-ui/browser tauri:build:bin",
    "browser:bundle": "pnpm --filter @sia-ui/browser tauri:build",
    "browser:web": "pnpm --filter @sia-ui/browser dev",
    "disk:dev": "pnpm --filter @sia-ui/disk-space tauri:dev",
    "disk:build": "pnpm --filter @sia-ui/disk-space tauri:build:bin",
    "disk:bundle": "pnpm --filter @sia-ui/disk-space tauri:build",
    "disk:web": "pnpm --filter @sia-ui/disk-space dev",
    "notepad:dev": "pnpm --filter @sia-ui/notepad tauri:dev",
    "notepad:build": "pnpm --filter @sia-ui/notepad tauri:build:bin",
    "notepad:bundle": "pnpm --filter @sia-ui/notepad tauri:build",
    "notepad:web": "pnpm --filter @sia-ui/notepad dev",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm build",
    "create:sia": "node packages/create-sia-web/cli.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2"
  }
}
