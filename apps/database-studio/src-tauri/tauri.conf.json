{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sia Data Studio",
  "version": "0.1.0",
  "identifier": "com.sia.data-studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sia Data Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/Sia.DataStudio.DatabaseHost.exe": "database-host.exe"
    },
    "category": "DeveloperTool",
    "shortDescription": "Sia WebUI database connection and SQL workbench"
  }
}
