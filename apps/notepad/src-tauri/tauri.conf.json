{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sia 记事本",
  "version": "0.1.0",
  "identifier": "com.sia.notepad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1470",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sia 记事本",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt", "json", "md", "markdown", "cs", "js", "jsx", "mjs", "cjs",
          "ts", "tsx", "html", "htm", "asp", "aspx", "ascx", "master", "asmx", "ashx",
          "css", "xml", "yaml", "yml", "ini",
          "py", "sql", "php",
          "rb", "pl", "lua"
        ],
        "name": "SiaNotepad.TextFile",
        "description": "Sia 记事本文本文件",
        "role": "Editor"
      }
    ]
  }
}
