{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sia 磁盘空间探测器",
  "version": "0.1.0",
  "identifier": "com.sia.disk-space",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1460",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sia 磁盘空间探测器",
        "width": 1380,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
