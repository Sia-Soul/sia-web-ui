{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "西娅浏览器",
  "version": "0.1.0",
  "identifier": "com.sia.browser",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1440",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": ["D:/SiaBuild/SiaWebUI/frontend-dist/browser"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "西娅浏览器",
        "width": 1380,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "西娅浏览器 · Sia Browser",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
