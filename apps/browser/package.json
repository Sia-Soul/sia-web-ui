{
  "name": "@sia-ui/browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:startup": "node ../../scripts/test-browser-startup.cjs",
    "test:input-reentrancy": "node ../../scripts/test-browser-input-reentrancy.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "tauri:build:bin": "cargo tauri build --no-bundle",
    "installer:build": "powershell -NoProfile -ExecutionPolicy Bypass -File build-installer.ps1"
  },
  "dependencies": {
    "@sia.soul/sia-react-ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
