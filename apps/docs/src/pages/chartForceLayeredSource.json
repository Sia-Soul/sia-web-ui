              }
            }
          },
          "minRadius": {
            "$expression": "constMinRadius"
          },
          "maxRadius": {
            "$expression": "constMaxRadius"
          },
          "nodes": {
            "$expression": "nodes"
          },
          "links": {
            "$expression": "links"
          }
        }
      ]
    }
