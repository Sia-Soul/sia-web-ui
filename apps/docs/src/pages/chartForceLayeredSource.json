      },
      "series": [
        {
          "type": "force",
          "name": "Force tree",
          "ribbonType": false,
          "categories": [
            {
              "name": "叶子节点",
              "itemStyle": {
                "normal": {
                  "color": "#ff7f50"
                }
              }
            },
            {
              "name": "非叶子节点",
              "itemStyle": {
                "normal": {
                  "color": "#6f57bc"
                }
              }
            },
            {
              "name": "根节点",
              "itemStyle": {
                "normal": {
                  "color": "#af0000"
                }
              }
            }
          ],
          "itemStyle": {
            "normal": {
              "label": {
                "show": false
              },
              "nodeStyle": {
                "brushType": "both",
                "strokeColor": "rgba(255,215,0,0.6)",
