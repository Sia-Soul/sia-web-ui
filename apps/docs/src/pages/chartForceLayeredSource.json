[
  {
    "id": "force4",
    "url": "http://static.dtws110.com/echarts-2.2.7/doc/example/force4.html",
    "status": 200,
    "hasEditor": true,
    "option": {
      "title": {
        "text": "Force",
        "subtext": "Force-directed tree",
