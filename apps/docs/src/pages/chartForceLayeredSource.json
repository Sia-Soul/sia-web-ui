      },
      "tooltip": {
        "trigger": "item",
        "formatter": "{a} : {b}"
      },
      "toolbox": {
        "show": true,
        "feature": {
          "restore": {
            "show": true
          },
          "magicType": {
            "show": true,
            "type": [
              "force",
              "chord"
            ]
          },
          "saveAsImage": {
            "show": true
          }
        }
      },
      "legend": {
        "x": "left",
        "data": [
          "叶子节点",
          "非叶子节点",
          "根节点"
