[
  {
    "id": "axis",
    "url": "http://static.dtws110.com/echarts-2.2.7/doc/example/axis.html",
    "status": 200,
    "hasEditor": true,
    "option": {
      "tooltip": {
        "trigger": "axis"
      },
      "legend": {
        "data": [
          "蒸发量",
          "降水量",
          "最低气温",
          "最高气温"
        ]
      },
      "toolbox": {
        "show": true,
        "feature": {
          "mark": {
            "show": true
