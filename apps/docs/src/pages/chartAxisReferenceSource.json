          "axisTick": {
            "show": true,
            "length": 10,
            "lineStyle": {
              "color": "red",
              "type": "solid",
              "width": 2
            }
          },
          "axisLabel": {
            "show": true,
            "interval": "auto",
            "rotate": 45,
            "margin": 8,
            "formatter": "{value}月",
            "textStyle": {
              "color": "blue",
              "fontFamily": "sans-serif",
              "fontSize": 15,
              "fontStyle": "italic",
              "fontWeight": "bold"
            }
